{
  "$comment": "Managed patches against prebuilt dependencies. Applied before build and asserted by scripts/verify-patches.mjs, so a yarn install cannot silently drop them.",
  "patches": [
    {
      "id": "brand-login-asset",
      "script": "scripts/apply-brand-patch.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/auth/frontend/login.js",
      "marker": "/brand.svg",
      "reason": "Upstream login page hardcodes /open-mercato.svg; the product must not ship the original brand asset path."
    },
    {
      "id": "cf-zh-defaults",
      "script": "scripts/patches/apply-custom-field-zh-defaults.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/customFieldDefaults.js",
      "marker": "/* [patched:cf-zh] */",
      "reason": "API merges code-defined custom fields over DB rows, so seeded English labels win over the translated database."
    },
    {
      "id": "empty-state-art",
      "script": "scripts/patches/apply-empty-state-art.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/filters/ListEmptyState.js",
      "marker": "/* [patched:empty-state-art] */",
      "reason": "ListEmptyState never passed the illustration slot the shared EmptyState primitive supports, so every empty list was plain text."
    },
    {
      "id": "empty-state-art-search",
      "script": "scripts/patches/apply-empty-state-art.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/filters/SearchEmptyResults.js",
      "marker": "/* [patched:empty-state-art] */",
      "reason": "Search no-results state rendered an icon circle instead of the brand illustration."
    },
    {
      "id": "dashboard-density-customer-todos",
      "script": "scripts/patches/apply-dashboard-density.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/customer-todos/widget.client.js",
      "marker": "/* [patched:dashboard-density] */",
      "reason": "Widget rows used p-3 / space-y-1.5 / mt-2, giving ~90px per record; tightened spacing raises records per screen."
    },
    {
      "id": "dashboard-density-next-interactions",
      "script": "scripts/patches/apply-dashboard-density.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/next-interactions/widget.client.js",
      "marker": "/* [patched:dashboard-density] */",
      "reason": "Widget rows used p-3 / space-y-1.5 / mt-2, giving ~90px per record; tightened spacing raises records per screen."
    },
    {
      "id": "nav-config",
      "script": "scripts/patches/apply-nav-config.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/auth/lib/backendChrome.js",
      "marker": "/* [patched:nav-groups] */",
      "reason": "One entry for navigation configuration: settings section merge plus page-group collapse, both sourced from src/nav."
    },
    {
      "id": "group-dashboard-widget-new-deals",
      "script": "scripts/patches/apply-group-dashboard-widget-new-deals.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "One entry for every change to widget.client.js: dashboard-date-locale-deals, dashboard-deal-status, dashboard-locale-init-deals, dashboard-density-new-deals"
    },
    {
      "id": "group-dashboard-widget-new-customers",
      "script": "scripts/patches/apply-group-dashboard-widget-new-customers.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-customers/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "One entry for every change to widget.client.js: dashboard-date-locale-customers, dashboard-locale-init-customers"
    },
    {
      "id": "group-app-shell-behaviour",
      "script": "scripts/patches/apply-group-app-shell-behaviour.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/AppShell.js",
      "marker": "/* [patched:nav-aria] */",
      "reason": "One entry for every change to AppShell.js: nav-aria-labels, sidebar-active-group, settings-sidebar-expanded, sidebar-footer-removed"
    },
    {
      "id": "vendor-source-build",
      "script": "scripts/patches/apply-vendor-source-build.mjs",
      "marker": "/* [patched:vendor-source-build] */",
      "targets": [
        "node_modules/@open-mercato/ui/dist/utils/format-locale.js",
        "node_modules/@open-mercato/ui/dist/utils/format.js",
        "node_modules/@open-mercato/ui/dist/backend/DataTable.js",
        "node_modules/@open-mercato/core/dist/modules/sales/components/documents/SalesDocumentsTable.js",
        "node_modules/@open-mercato/core/dist/modules/sales/commands/documents.js",
        "node_modules/@open-mercato/core/dist/modules/dictionaries/commands/factory.js",
        "node_modules/@open-mercato/core/dist/modules/sales/api/quotes/convert/route.js",
        "node_modules/@open-mercato/core/dist/modules/sales/api/quotes/send/route.js",
        "node_modules/@open-mercato/core/dist/modules/customers/lib/customFieldOptionLabel.js",
        "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/companies/page.js",
        "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/people/page.js",
        "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/deals/page.js",
        "node_modules/@open-mercato/core/dist/modules/communication_channels/subscribers/outbound-bridge.js"
      ],
      "reason": "Files compiled from the private mirror packages/** source of truth, stored in vendor/open-mercato/prebuilt (not dist/: git ignores dist). One installer, one marker per target, content guards per file."
    }
  ]
}
