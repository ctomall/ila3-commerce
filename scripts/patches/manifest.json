{
  "$comment": "Managed patches against prebuilt dependencies. Applied before build and asserted by scripts/verify-patches.mjs, so a yarn install cannot silently drop them.",
  "patches": [
    {
      "id": "brand-login-asset",
      "script": "scripts/apply-brand-patch.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/auth/frontend/login.js",
      "marker": "/brand.svg",
      "reason": "Upstream login page hardcodes /open-mercato.svg; the product must not ship the original brand asset path."
    },
    {
      "id": "cf-label-companies",
      "script": "scripts/patches/apply-custom-field-cell-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/companies/page.js",
      "marker": "/* [patched:cf-label] */",
      "reason": "Select custom-field cells stringify the raw code; the page builds customColumns inline and its cell closure never receives the field definition."
    },
    {
      "id": "cf-label-people",
      "script": "scripts/patches/apply-custom-field-cell-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/people/page.js",
      "marker": "/* [patched:cf-label] */",
      "reason": "Same list pattern as companies."
    },
    {
      "id": "dashboard-date-locale-deals",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "formatDate falls back to the runtime locale, so a zh UI rendered en-US dates."
    },
    {
      "id": "dashboard-date-locale-customers",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-customers/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "Same formatter in the new-customers widget."
    },
    {
      "id": "dashboard-deal-status",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-status] */",
      "reason": "Renders item.status verbatim; routes it through the existing quickDeal.status dictionary keys."
    },
    {
      "id": "dashboard-locale-init-deals",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-locale-init] */",
      "reason": "The widget seeds its date locale from navigator.language, so a zh UI rendered en-US dates."
    },
    {
      "id": "dashboard-locale-init-customers",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-customers/widget.client.js",
      "marker": "/* [patched:dashboard-locale-init] */",
      "reason": "The widget seeds its date locale from navigator.language, so a zh UI rendered en-US dates."
    }
  ]
}
