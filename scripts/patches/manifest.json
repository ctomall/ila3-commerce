{
  "$comment": "Managed patches against prebuilt dependencies. Applied before build and asserted by scripts/verify-patches.mjs, so a yarn install cannot silently drop them.",
  "patches": [
    {
      "id": "brand-login-asset",
      "script": "scripts/apply-brand-patch.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/auth/frontend/login.js",
      "marker": "/brand.svg",
      "reason": "Upstream login page hardcodes /open-mercato.svg; the product must not ship the original brand asset path."
    },
    {
      "id": "cf-label-companies",
      "script": "scripts/patches/apply-custom-field-cell-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/companies/page.js",
      "marker": "/* [patched:cf-label] */",
      "reason": "Select custom-field cells stringify the raw code; the page builds customColumns inline and its cell closure never receives the field definition."
    },
    {
      "id": "cf-label-people",
      "script": "scripts/patches/apply-custom-field-cell-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/people/page.js",
      "marker": "/* [patched:cf-label] */",
      "reason": "Same list pattern as companies."
    },
    {
      "id": "dashboard-date-locale-deals",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "formatDate falls back to the runtime locale, so a zh UI rendered en-US dates."
    },
    {
      "id": "dashboard-date-locale-customers",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-customers/widget.client.js",
      "marker": "/* [patched:dashboard-locale] */",
      "reason": "Same formatter in the new-customers widget."
    },
    {
      "id": "dashboard-deal-status",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-status] */",
      "reason": "Renders item.status verbatim; routes it through the existing quickDeal.status dictionary keys."
    },
    {
      "id": "dashboard-locale-init-deals",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-deals/widget.client.js",
      "marker": "/* [patched:dashboard-locale-init] */",
      "reason": "The widget seeds its date locale from navigator.language, so a zh UI rendered en-US dates."
    },
    {
      "id": "dashboard-locale-init-customers",
      "script": "scripts/patches/apply-dashboard-widget-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/widgets/dashboard/new-customers/widget.client.js",
      "marker": "/* [patched:dashboard-locale-init] */",
      "reason": "The widget seeds its date locale from navigator.language, so a zh UI rendered en-US dates."
    },
    {
      "id": "nav-aria-labels",
      "script": "scripts/patches/apply-nav-aria-labels.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/AppShell.js",
      "marker": "/* [patched:nav-aria] */",
      "reason": "Collapsed nav rail renders icon-only links with the label in title (tooltip only), leaving no accessible name."
    },
    {
      "id": "cf-zh-defaults",
      "script": "scripts/patches/apply-custom-field-zh-defaults.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/customFieldDefaults.js",
      "marker": "/* [patched:cf-zh] */",
      "reason": "API merges code-defined custom fields over DB rows, so seeded English labels win over the translated database."
    },
    {
      "id": "cf-label-deals",
      "script": "scripts/patches/apply-custom-field-cell-labels.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/deals/page.js",
      "marker": "/* [patched:cf-label-deals] */",
      "reason": "Deals list builds its custom-field cell inline and stringifies raw option codes."
    },
    {
      "id": "column-priority",
      "script": "scripts/patches/apply-column-priority.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/companies/page.js",
      "marker": "/* [patched:column-priority] */",
      "reason": "Default view showed ~10 columns and overflowed at 1280px; secondary columns are demoted to the chooser."
    },
    {
      "id": "column-priority-deals",
      "script": "scripts/patches/apply-column-priority.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/customers/backend/customers/deals/page.js",
      "marker": "/* [patched:column-priority] */",
      "reason": "Deals list opened with 16 columns; secondary columns are demoted to the chooser."
    },
    {
      "id": "settings-groups",
      "script": "scripts/patches/apply-settings-groups.mjs",
      "target": "node_modules/@open-mercato/core/dist/modules/auth/lib/backendChrome.js",
      "marker": "/* [patched:settings-groups] */",
      "reason": "Settings rail sections are serialized server-side; merged 12 -> 8 by labelKey (labels are still default English at that point)."
    },
    {
      "id": "empty-state-art",
      "script": "scripts/patches/apply-empty-state-art.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/filters/ListEmptyState.js",
      "marker": "/* [patched:empty-state-art] */",
      "reason": "ListEmptyState never passed the illustration slot the shared EmptyState primitive supports, so every empty list was plain text."
    },
    {
      "id": "empty-state-art-search",
      "script": "scripts/patches/apply-empty-state-art.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/filters/SearchEmptyResults.js",
      "marker": "/* [patched:empty-state-art] */",
      "reason": "Search no-results state rendered an icon circle instead of the brand illustration."
    },
    {
      "id": "empty-state-art-default",
      "script": "scripts/patches/apply-empty-state-art.mjs",
      "target": "node_modules/@open-mercato/ui/dist/backend/DataTable.js",
      "marker": "/* [patched:empty-state-art] */",
      "reason": "DataTable default empty state ignored the illustration slot."
    }
  ]
}
