id: 10
data: {"seq":9,"type":"dsh.event","dshType":"session.event","payload":{"event":{"seq":7,"data":{"header":{"tools":[{"name":"bash","parameters":{"type":"object","required":["command"],"properties":{"command":{"type":"string","description":"The bash command to run. Relative path is preferred in the command."}}},"description":"Run commands in a bash shell\n* When invoking this tool, the contents of the \"command\" parameter does NOT need to be XML-escaped.\n* Network access depends on the task environment. Prefer configured mirrors/proxies when they are available.\n* State is persistent across command calls and discussions with the user.\n* To inspect a particular line range of a file, e.g. lines 10-25, try 'sed -n 10,25p /path/to/the/file'.\n* Please avoid commands that may produce a very large amount of output.\n* Please run long lived commands in the background, e.g. 'sleep 10 &' or start a server in the background."},{"name":"list_mcp_resource_templates","parameters":{"type":"object","required":["server"],"properties":{"cursor":{"type":"string","description":"Continuation cursor returned by this server."},"server":{"type":"string","description":"Configured MCP server name."}}},"description":"List parameterized resource URI templates from an MCP server."},{"name":"list_mcp_resources","parameters":{"type":"object","required":["server"],"properties":{"cursor":{"type":"string","description":"Continuation cursor returned by this server."},"server":{"type":"string","description":"Configured MCP server name."}}},"description":"List resources available from an MCP server."},{"name":"mcp__crm__crm_find_companies","parameters":{"type":"object","properties":{"limit":{"type":"integer","maximum":20,"minimum":1,"description":"Maximum companies to return (default 5, hard cap 20)."},"query":{"type":"string","maxLength":120,"description":"Case-insensitive substring matched against company name, domain, website or industry."}},"additionalProperties":false},"description":"Find CRM companies visible to the authenticated employee (read-only). Results are already scoped to the caller tenant/organization; do not ask for tenant or owner filters."},{"name":"read_image","parameters":{"type":"object","required":["file_path"],"properties":{"file_path":{"type":"string","description":"Path to the image file, resolved by the filesystem backend."}}},"description":"Read a PNG/JPEG/WebP/GIF file and return the image itself. Large images are downscaled automatically; do not install image libraries or create thumbnails to inspect an image."},{"name":"read_mcp_resource","parameters":{"type":"object","required":["server","uri"],"properties":{"uri":{"type":"string","description":"Resource URI to read."},"server":{"type":"string","description":"Configured MCP server name."}}},"description":"Read an MCP resource by URI from the named server. Use a listed URI or an expanded resource template."},{"name":"working_directory","parameters":{"type":"object","properties":{"cd":{"type":"string","description":"Existing directory to enter. Omit to read the current directory."}}},"description":"Read the current working directory, or change it with cd. Relative paths use the current directory. Existing shells and running processes keep their own directories."}],"config":{"model":"deepseek-flash","provider":"deepseek-official","maxTokens":256000,"reasoningEffort":"high"},"adapterDefaults":{"maxTokens":true,"reasoningEffort":true}},"reason":"initial"},"time":1794395923822,"type":"request/header"},"sessionId":"session-8e121a606c134f0cb8c5e1b6c4a1ec62"},"dshEventType":"request/header"}

